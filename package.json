{
  "name": "careerflow",
  "version": "0.1.0",
  "description": "Local-first academic and career intelligence desktop application.",
  "author": "CareerFlow Project",
  "private": true,
  "type": "module",
  "main": "shell/src/main.js",
  "workspaces": [
    "core",
    "shell",
    "ui"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:ui",
    "build:core": "npm run build -w @careerflow/core",
    "build:ui": "npm run build -w @careerflow/ui",
    "dev:ui": "npm run dev -w @careerflow/ui",
    "dev:shell": "wait-on tcp:127.0.0.1:5173 && electron .",
    "dev": "concurrently -k -n UI,SHELL -c cyan,magenta \"npm:dev:ui\" \"npm:dev:shell\"",
    "check:ipc": "node scripts/check-ipc.mjs",
    "check:napi": "node scripts/check-napi.mjs",
    "check:esm": "node scripts/check-esm.mjs",
    "check:cdp-boundary": "node scripts/check-cdp-auth-boundary.mjs",
    "dist": "npm run build && electron-builder --config electron-builder.yml --win",
    "dist:dir": "npm run build && electron-builder --config electron-builder.yml --dir",
    "test:core": "cargo test --manifest-path core/Cargo.toml -- --test-threads=1",
    "test:ui": "npm run test -w @careerflow/ui",
    "test:e2e": "playwright test",
    "test:e2e:batched": "node scripts/run-e2e-batched.mjs",
    "test:shell": "node --test shell/tests/*.test.js",
    "test:nightly": "CAREERFLOW_LIVE_TEST=1 node --test shell/tests/provider-live.test.js",
    "test": "npm run check:ipc && npm run check:napi && npm run check:esm && npm run check:cdp-boundary && npm run test:shell && npm run test:ui && npm run test:core",
    "rebuild:native:electron": "node scripts/rebuild-native.mjs electron",
    "check:native-loader": "node scripts/test-native-loader.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "concurrently": "^10.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^24.0.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "playwright-core": "^1.62.1"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "allowScripts": {
    "0": "electron",
    "1": "better-sqlite3",
    "electron@44.3.0": true,
    "better-sqlite3@13.0.3": true
  }
}
